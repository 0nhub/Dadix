ENV="dev"

PORT=6127

ALLOWED_ORIGIN="http://localhost:3000"
DOMAIN=".example.com"
SECURE=false
SAMESITE="lax"

DATABASE_URI="postgresql://USER:PASSWORD@HOST/dadix?sslmode=require"
USERS_PROJECTS_DATABASE_URI="postgresql://USER:PASSWORD@HOST/projects?sslmode=require"

ACCESS_TOKEN_SECRET="replace-with-a-long-random-string"
ACCESS_TOKEN_EXPIRES_IN="15m"

REFRESH_TOKEN_SECRET="replace-with-a-long-random-string"
REFRESH_TOKEN_EXPIRES_IN="7d"

SESSION_EXPIRES_IN="30d"

FRONTEND_ORIGIN="http://localhost:3000"
MAIL_DOMAIN="example.com"
EMAILIT_KEY=""

API_KEY_SECRET="replace-with-a-long-random-string"

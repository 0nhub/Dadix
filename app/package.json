{
  "name": "dadix-app",
  "version": "0.0.1",
  "private": true,
  "description": "Dadix – Backend (Express) + Frontend (Next.js)",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && nodemon server.js",
    "dev:client": "next dev --hostname localhost --turbopack",
    "build": "next build",
    "start": "next start",
    "start:server": "cd server && node server.js",
    "start:client": "next start",
    "lint": "next lint && cd server && eslint .",
    "lint:server": "cd server && eslint .",
    "lint:client": "next lint",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "seed:test-user": "cd server && node scripts/seed-test-user.js"
  },
  "dependencies": {

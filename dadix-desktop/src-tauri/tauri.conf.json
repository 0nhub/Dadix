{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dadix",
  "version": "0.1.0",
  "identifier": "net.dadix.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dadix",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["dadix"],
        "name": "Dadix Project",
        "description": "Dadix project document",
        "mimeType": "application/vnd.dadix.project",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "net.dadix.desktop.dadix",
          "conformsTo": ["public.data", "public.database"]
        }
      }
    ]
  }
}
